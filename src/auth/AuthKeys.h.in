#ifndef AuthKeys_H
#define AuthKeys_H

// Generated by CMake from src/auth/AuthKeys.h.in. Do not edit the generated
// copy. The IA2 endpoints and scope are public CMake defaults; the client
// credentials are never committed and are passed at configure time,
//
//   cmake -DVISIVO_VLKB_CLIENT_ID=... -DVISIVO_VLKB_CLIENT_SECRET=...
//
// and in the release workflow from the repository's secrets. A build made
// without them has no VLKB sign-in; the Settings dialog says so instead of
// starting an authorization flow that has nowhere to go.

#define VLKB_AUTH_URL "@VISIVO_VLKB_AUTH_URL_C@"
#define VLKB_TOKEN_URL "@VISIVO_VLKB_TOKEN_URL_C@"
#define VLKB_SCOPE "@VISIVO_VLKB_SCOPE_C@"
#define VLKB_CLIENT_ID "@VISIVO_VLKB_CLIENT_ID_C@"
#define VLKB_SECRET "@VISIVO_VLKB_CLIENT_SECRET_C@"

#define VLKB_TAP_USER "@VISIVO_VLKB_TAP_USER_C@"
#define VLKB_TAP_SECRET "@VISIVO_VLKB_TAP_SECRET_C@"

#endif
