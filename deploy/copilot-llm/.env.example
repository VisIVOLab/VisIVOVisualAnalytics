# ── VisIVO copilot LLM server config ────────────────────────────────────────
# Copy to `.env` and edit. At minimum set VLLM_API_KEY.

# Model to serve. Default: ungated, fits an RTX PRO 6000 (96 GB) in bf16, strong
# tool-calling. See README for bigger options (70B AWQ, gpt-oss-120b, Llama 3.3).
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
SERVED_NAME=visivo-copilot

# Tool-call parser — MUST match the model family:
#   hermes        → Qwen2.5 / Qwen3
#   llama3_json   → Llama 3.1 / 3.3
#   mistral       → Mistral / Mixtral
TOOL_PARSER=hermes
ENABLE_TOOLS=1

# GPU / context. Lower MAX_MODEL_LEN if a model won't fit; raise GPU_UTIL toward
# 0.95 to use more VRAM.
GPU_UTIL=0.90
MAX_MODEL_LEN=32768
# QUANTIZATION: leave EMPTY for none; set awq/gptq to serve a quantized 70B.
# NOTE: no inline comments on value lines — the env_file parser would fold them
# into the value (e.g. QUANTIZATION would become "# ..." and break vLLM args).
QUANTIZATION=

# The key clients must present. Paste the SAME value into the VisIVO copilot ⚙
# ("Your server" → Key). Change it from the default!
VLLM_API_KEY=change-me

# Host port the endpoint is published on (→ http://<server>:PORT/v1).
LLM_PORT=8000

# Where models are cached on the host (downloaded once).
HF_CACHE=./hf-cache

# ONLY for GATED models (Llama 3.3, etc.): your Hugging Face access token.
HUGGING_FACE_HUB_TOKEN=

# Pin the vLLM image (default: latest).
VLLM_TAG=latest

# Extra raw vLLM flags, if you need them (e.g. --tensor-parallel-size 1).
EXTRA_ARGS=

# ── Full stack only (docker-compose.full.yml: backend + LLM together) ────────
# Auth token the VisIVO desktop app must present to the backend. CHANGE IT.
VISIVO_TOKEN=change-me-visivo-token
# Host port the backend is published on (the desktop app connects to :BACKEND_PORT).
BACKEND_PORT=8080
# Host directory with your FITS cubes/catalogues, mounted read-only at /data.
DATA_DIR=./data
# Backend compute worker processes.
VISIVO_WORKERS=4

