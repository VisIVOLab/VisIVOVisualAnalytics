Bootstrap: docker
From: condaforge/mambaforge:latest

%labels
    Maintainer VisIVOLab <visivo@inaf.it>
    Version    1.0.0-conda-egl
    Description VisIVO Backend (conda-forge + custom VTK-EGL) — server-side rendering on ppc64le / x86_64

%help
    Variant of ``backend-conda.def`` that builds VTK 9.3.1 from source
    with EGL support instead of using the conda-forge Qt/X11 VTK
    binary. Enables hardware-accelerated OFFSCREEN volume rendering
    via NVIDIA EGL on any node where:

      * the NVIDIA driver provides ``libEGL_nvidia.so.0``
        (550.x or newer — the 545+ EGL stack is stable on ppc64le)
      * Apptainer's ``--nv`` flag exposes the driver libs (or the
        runner explicitly ``--bind``s them — on some ppc64le
        installs ``--nv`` is incomplete; see ``run_spike_egl.sh``)

    Everything else (scientific stack, FastAPI, cupy, FastAPI router,
    SLURM scripts) is identical to ``backend-conda.def``. The image
    is ~800 MB larger because the VTK build artefacts live under
    /opt/conda/include + /opt/conda/lib/cmake.

    ── Build ────────────────────────────────────────────────────────────
    # From the repo root, fakeroot build
    apptainer build --fakeroot backend-egl.sif apptainer/backend-conda-egl.def

    # With cupy + EGL (full GPU stack)
    ENABLE_CUPY=1 \\
        apptainer build --fakeroot backend-egl.sif apptainer/backend-conda-egl.def

    Build time on ppc64le V100 (16 cores): ~70-90 min (vs 20-30 min
    for the conda-only variant). The VTK build dominates; rest is
    identical to backend-conda.def.

    ── Run ──────────────────────────────────────────────────────────────
    # Smoke-test EGL rendering on a GPU node
    bash apptainer/run_spike_egl.sh /mnt/beegfs/.../cube.fits /tmp/out.png

    # Run the backend (normal — same flags as backend-conda.def)
    apptainer run --nv --bind /data:/data backend-egl.sif

    ── What's different from backend-conda.def ─────────────────────────
    * Stage 2 installs ``vtk-base`` and build deps (cmake, ninja,
      libegl-cos7-ppc64le, libglvnd, mesa-libglu-cos7-ppc64le)
      INSTEAD of the full ``vtk`` package.
    * NEW Stage 2.5: clones VTK 9.3.1 source from gitlab.kitware.com,
      configures with ``-DVTK_USE_X=OFF -DVTK_OPENGL_HAS_EGL=ON
      -DVTK_DEFAULT_RENDER_WINDOW_HEADLESS=ON``, builds, installs to
      /opt/conda.
    * %test additionally verifies ``vtkRenderingEGL`` importable and
      probes ``vtkEGLRenderWindow`` creation.

    Set ``SKIP_VTK_BUILD=1`` in the build environment to abort if the
    VTK source build fails — useful when iterating on the scientific
    stack only.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/conda/bin:${PATH}
    export VISIVO_SESSION_TTL=${VISIVO_SESSION_TTL:-1800}

    # VTK install paths — make sure our custom-built libs win over any
    # leftover system VTK that might be on a host's LD_LIBRARY_PATH.
    export LD_LIBRARY_PATH=/opt/conda/lib:${LD_LIBRARY_PATH:-}

    # Force VTK to pick the EGL render window factory at runtime.
    # Mesa's offscreen path also looks at this var; setting it forces
    # the EGL-native code path even when X11 deps are present.
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

%post
    set -e

    . /opt/conda/etc/profile.d/conda.sh
    conda activate base

    CONDA_INSTALLER="${CONDA_INSTALLER:-conda}"
    case "$CONDA_INSTALLER" in
        mamba) INSTALL_CMD="mamba install -y" ;;
        conda) INSTALL_CMD="conda install -y --no-lock" ;;
        *) echo "ERROR: CONDA_INSTALLER must be 'mamba' or 'conda'"; exit 1 ;;
    esac
    echo "[backend-conda-egl.def] Using installer: $INSTALL_CMD"

    REQS=$(find /srv/backend_src -name requirements.txt -print -quit 2>/dev/null)
    if [ -z "$REQS" ]; then
        echo "ERROR: requirements.txt not found under /srv/backend_src"
        exit 1
    fi
    SRC_DIR=$(dirname "$REQS")

    # ── Stage 1 — same as backend-conda.def ────────────────────────────
    echo "[backend-conda-egl.def] Stage 1/5 — foundation"
    $INSTALL_CMD -n base -c conda-forge \
        python=3.12 \
        numpy \
        "scipy<1.14" \
        astropy \
        pandas \
        healpy \
        pyerfa \
        pillow \
        pip

    # ── Stage 2 — VTK BUILD DEPS ──────────────────────────────────────
    # Mesa / EGL dev libs are NOT in conda-forge for ppc64le (and only
    # partially on x86_64). The condaforge/mambaforge base image is
    # Debian-based, so install the system EGL/GL development packages
    # via apt — they provide:
    #
    #   /usr/include/EGL/egl.h, eglext.h, …
    #   /usr/include/GL/gl.h, glext.h
    #   /usr/lib/<arch>/libEGL.so, libGL.so       (build-time stubs)
    #
    # At runtime, ``--nv`` (or our explicit binds in run_spike_egl.sh)
    # overrides these stub .so with the actual NVIDIA driver libs from
    # the host. The build only needs the headers + ABI to link against.
    echo "[backend-conda-egl.def] Stage 2a/5 — System EGL/GL dev headers + compilers (apt)"
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        libegl-dev \
        libegl1 \
        libgl-dev \
        libgl1 \
        libglvnd-dev \
        libgles-dev \
        mesa-common-dev \
        libx11-dev \
        libxext-dev \
        libxt-dev
    rm -rf /var/lib/apt/lists/*

    # Sanity probe — VTK's find_package(EGL) reads the same files we
    # check here. If any are missing, the cmake configure step below
    # silently disables ``VTK_MODULE_ENABLE_VTK_RenderingEGL``.
    EGL_ARCH="$(gcc -print-multiarch 2>/dev/null || echo)"
    echo "[backend-conda-egl.def] gcc reports multiarch: ${EGL_ARCH:-<unknown>}"
    EGL_LIBDIR="/usr/lib/${EGL_ARCH}"
    if [ -z "$EGL_ARCH" ] || [ ! -d "$EGL_LIBDIR" ]; then
        for cand in /usr/lib64 /usr/lib; do
            if [ -e "$cand/libEGL.so" ] || [ -e "$cand/libEGL.so.1" ]; then
                EGL_LIBDIR="$cand"
                break
            fi
        done
    fi
    echo "[backend-conda-egl.def] EGL libdir: $EGL_LIBDIR"
    ls -la "$EGL_LIBDIR"/libEGL* "$EGL_LIBDIR"/libGL* 2>/dev/null || true

    # The libegl1 package ships libEGL.so.1; the *-dev package ships
    # the libEGL.so unversioned symlink. If only .1 is present, the
    # cmake configure can fail to link — create the symlink defensively.
    if [ ! -e "$EGL_LIBDIR/libEGL.so" ] && [ -e "$EGL_LIBDIR/libEGL.so.1" ]; then
        echo "[backend-conda-egl.def] Adding missing libEGL.so symlink in $EGL_LIBDIR"
        ln -sf libEGL.so.1 "$EGL_LIBDIR/libEGL.so"
    fi
    if [ ! -e "$EGL_LIBDIR/libGL.so" ] && [ -e "$EGL_LIBDIR/libGL.so.1" ]; then
        ln -sf libGL.so.1 "$EGL_LIBDIR/libGL.so"
    fi

    # Headers — egl.h MUST be under /usr/include/EGL/ for VTK to find
    # it. ``apt install libegl-dev`` puts it there but the package
    # check is non-fatal so we re-verify.
    if [ ! -f "/usr/include/EGL/egl.h" ]; then
        echo "[backend-conda-egl.def] FATAL: /usr/include/EGL/egl.h missing after apt install"
        echo "[backend-conda-egl.def] Contents of /usr/include/EGL/:"
        ls -la /usr/include/EGL/ 2>/dev/null || echo "  (directory missing)"
        exit 1
    fi
    if [ ! -f "/usr/include/KHR/khrplatform.h" ]; then
        echo "[backend-conda-egl.def] WARN: /usr/include/KHR/khrplatform.h missing — egl.h transitively requires it"
        apt-get update && apt-get install -y --no-install-recommends libegl1-mesa-dev khronos-headers-egl 2>/dev/null || true
    fi

    # Export the path for the cmake invocation below.
    export EGL_LIBDIR
    export EGL_LIB="$EGL_LIBDIR/libEGL.so"
    export EGL_INCLUDE_DIR="/usr/include"
    # Make these paths CMake-discoverable globally — VTK's
    # ``find_package(EGL)`` calls into ``CMake/FindEGL.cmake`` which
    # respects CMAKE_PREFIX_PATH / CMAKE_LIBRARY_PATH /
    # CMAKE_INCLUDE_PATH. Setting them belt-and-braces alongside the
    # explicit -DEGL_LIBRARY=... below.
    export CMAKE_PREFIX_PATH="/usr:${CMAKE_PREFIX_PATH:-}"
    export CMAKE_LIBRARY_PATH="$EGL_LIBDIR:${CMAKE_LIBRARY_PATH:-}"
    export CMAKE_INCLUDE_PATH="$EGL_INCLUDE_DIR:${CMAKE_INCLUDE_PATH:-}"

    echo "[backend-conda-egl.def] EGL paths used for cmake:"
    echo "                       EGL_LIB=$EGL_LIB"
    echo "                       EGL_INCLUDE_DIR=$EGL_INCLUDE_DIR"
    echo "                       CMAKE_PREFIX_PATH=$CMAKE_PREFIX_PATH"
    ls -la "$EGL_LIB" || (echo "FATAL: $EGL_LIB still missing"; exit 1)
    ls -la "$EGL_INCLUDE_DIR/EGL/egl.h" \
        || (echo "FATAL: egl.h still missing"; exit 1)

    echo "[backend-conda-egl.def] Stage 2b/5 — Python toolchain + HDF5 via conda"
    $INSTALL_CMD -n base -c conda-forge \
        h5py \
        cmake \
        ninja \
        git \
        pkg-config

    # ── Stage 3 — Numba JIT (unchanged from backend-conda.def) ────────
    echo "[backend-conda-egl.def] Stage 3/5 — Numba JIT"
    $INSTALL_CMD -n base -c conda-forge numba llvmlite

    # ── Stage 4 — Web framework + science add-ons ────────────────────
    echo "[backend-conda-egl.def] Stage 4a — Web framework"
    $INSTALL_CMD -n base -c conda-forge fastapi uvicorn-standard
    echo "[backend-conda-egl.def] Stage 4b — Astronomy analysis"
    $INSTALL_CMD -n base -c conda-forge photutils reproject scikit-image
    echo "[backend-conda-egl.def] Stage 4c — Astroquery"
    $INSTALL_CMD -n base -c conda-forge astroquery
    echo "[backend-conda-egl.def] Stage 4d — Distributed compute"
    $INSTALL_CMD -n base -c conda-forge dask distributed

    # Optional cupy.
    if [ "${ENABLE_CUPY:-0}" = "1" ]; then
        echo "[backend-conda-egl.def] ENABLE_CUPY=1 → installing cupy"
        $INSTALL_CMD -n base -c conda-forge cupy
    fi

    # ── Stage 5 — BUILD VTK 9.3.1 FROM SOURCE WITH EGL ────────────────
    # This is the only stage that differs structurally from
    # backend-conda.def. It clones VTK, configures with EGL/headless
    # flags, builds, installs into /opt/conda.
    VTK_TAG="${VTK_TAG:-v9.3.1}"
    echo "[backend-conda-egl.def] Stage 5/5 — Building VTK $VTK_TAG from source"
    cd /tmp
    # Clear any leftover from a previous failed build attempt — Apptainer
    # preserves /tmp across rebuilds of the same SIF when the build
    # failed mid-%post.
    rm -rf /tmp/vtk-src /tmp/vtk-build
    git clone --depth 1 --branch "$VTK_TAG" \
        https://gitlab.kitware.com/vtk/vtk.git vtk-src
    mkdir -p vtk-build
    cd vtk-build

    # NOTE on flags:
    #   * VTK_USE_X=OFF                  → drop all X11 deps. Mandatory
    #                                       for headless EGL builds.
    #   * VTK_OPENGL_HAS_EGL=ON          → enable EGL in vtkOpenGLRenderer.
    #   * VTK_DEFAULT_RENDER_WINDOW_HEADLESS=ON → make EGL the default
    #                                       window backend at runtime.
    #   * VTK_WRAP_PYTHON=ON             → build the vtkmodules python
    #                                       bindings the backend imports.
    #   * BUILD_SHARED_LIBS=ON           → match conda-forge convention;
    #                                       smaller .sif than static.
    #   * VTK_GROUP_ENABLE_*=YES         → enable the standard groups we
    #                                       need (rendering, charts,
    #                                       volume, slicing, IO).
    #   * VTK_OPENGL_USE_GLES=OFF        → desktop OpenGL, not GLES.
    # Explicit EGL paths so VTK's find_package(EGL) succeeds even on
    # Debian ppc64le where the multiarch dir layout confuses CMake's
    # default search paths. We export EGL_LIBDIR / EGL_LIB /
    # EGL_INCLUDE_DIR in Stage 2a from gcc -print-multiarch; reuse
    # them here.
    # CRITICAL: every -D needs an EXPLICIT :TYPE annotation. Without it
    # cmake stores the value as "UNINITIALIZED" in CMakeCache.txt and
    # VTK's option()/cmake_dependent_option() calls never see the
    # override. The previous attempt failed exactly here — CMake said
    # "Manually-specified variables were not used by the project".
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE:STRING=Release \
        -DCMAKE_INSTALL_PREFIX:PATH=/opt/conda \
        -DCMAKE_INSTALL_LIBDIR:STRING=lib \
        -DBUILD_SHARED_LIBS:BOOL=ON \
        -DBUILD_TESTING:BOOL=OFF \
        -DBUILD_EXAMPLES:BOOL=OFF \
        -DVTK_USE_X:BOOL=OFF \
        -DVTK_USE_COCOA:BOOL=OFF \
        -DVTK_OPENGL_HAS_EGL:BOOL=ON \
        -DVTK_OPENGL_HAS_OSMESA:BOOL=OFF \
        -DVTK_OPENGL_USE_GLES:BOOL=ON \
        -DVTK_DEFAULT_RENDER_WINDOW_HEADLESS:BOOL=ON \
        -DOPENGL_egl_LIBRARY:FILEPATH="$EGL_LIB" \
        -DOPENGL_EGL_INCLUDE_DIR:PATH="$EGL_INCLUDE_DIR" \
        -DEGL_INCLUDE_DIR:PATH="$EGL_INCLUDE_DIR" \
        -DEGL_LIBRARY:FILEPATH="$EGL_LIB" \
        -DVTK_WRAP_PYTHON:BOOL=ON \
        -DVTK_PYTHON_VERSION:STRING=3 \
        -DPython3_EXECUTABLE:FILEPATH=/opt/conda/bin/python \
        -DVTK_GROUP_ENABLE_StandAlone:STRING=YES \
        -DVTK_GROUP_ENABLE_Rendering:STRING=YES \
        -DVTK_GROUP_ENABLE_Imaging:STRING=YES \
        -DVTK_GROUP_ENABLE_MPI:STRING=DONT_WANT \
        -DVTK_GROUP_ENABLE_Qt:STRING=DONT_WANT \
        -DVTK_GROUP_ENABLE_Views:STRING=YES \
        -DVTK_GROUP_ENABLE_Web:STRING=DONT_WANT \
        -DVTK_MODULE_ENABLE_VTK_RenderingVolume:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingVolumeOpenGL2:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingOpenGL2:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingLICOpenGL2:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_RenderingCellGrid:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_FiltersCellGrid:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_IOCellGrid:STRING=NO \
        ../vtk-src 2>&1 | tee /tmp/vtk-cmake.log

    # NOTE: with VTK_OPENGL_USE_GLES=ON several VTK modules that hard-
    # code Desktop-GL constants fail to compile (vtkLineIntegralConvolution2D
    # uses vtkTextureObject::ClampToBorder; vtkDGOpenGLRenderer uses
    # GL_TEXTURE_CUBE_MAP_SEAMLESS). Both are surface-rendering /
    # vector-flow extras that the VisIVO backend does not use — its
    # rendering surface is volume + slice. Disabling them here keeps
    # the build clean. If a future backend feature needs LIC or
    # cell-grid rendering, switch to the GLES-compatible upstream
    # branch (or wait for VTK 9.4 which fixes the GLES paths).

    # NOTE: VTK 9.3 does NOT have a separate vtkRenderingEGL module.
    # The ``vtkEGLRenderWindow`` class lives inside vtkRenderingOpenGL2
    # and is conditionally compiled when ``VTK_OPENGL_HAS_EGL=ON``.
    # That's why the previous attempt's
    # ``-DVTK_MODULE_ENABLE_VTK_RenderingEGL=YES`` was ignored and CMake
    # warned "Manually-specified variables were not used" — there's
    # nothing called that. Removing the flag is the fix.

    # HARD CHECK — confirm EGL_LIBRARY/EGL_INCLUDE_DIR are stored as
    # the right types AND that vtkEGLRenderWindow.cxx is in the build
    # graph (it's INSIDE the vtkRenderingOpenGL2 module, not a separate
    # module — VTK 9.3 quirk).
    echo "==================================================================="
    echo "[backend-conda-egl.def] Post-configure EGL detection check:"
    grep -E "^EGL_(LIBRARY|INCLUDE_DIR):" CMakeCache.txt \
        || echo "  EGL_* vars NOT in CMakeCache.txt — bad sign"
    grep -E "VTK_OPENGL_HAS_EGL" CMakeCache.txt || true

    echo "[backend-conda-egl.def] EGLRenderWindow source files in ninja graph:"
    grep -iE "vtkEGLRenderWindow" build.ninja 2>/dev/null \
        | head -5 \
        || echo "  none — EGL window source NOT compiled"

    echo "[backend-conda-egl.def] cmake configure log excerpt (egl):"
    grep -iE "EGL|Found .*EGL|find_package.*EGL" /tmp/vtk-cmake.log \
        | grep -v "Warning\|^[+-]" | head -20 || true
    echo "==================================================================="

    if ! grep -qE "^EGL_LIBRARY:FILEPATH=.+libEGL" CMakeCache.txt 2>/dev/null; then
        echo "[backend-conda-egl.def] FATAL: EGL_LIBRARY not stored as FILEPATH in cache."
        exit 1
    fi
    if ! grep -qiE "vtkEGLRenderWindow" build.ninja 2>/dev/null; then
        echo "[backend-conda-egl.def] FATAL: vtkEGLRenderWindow.cxx not in build graph."
        echo "[backend-conda-egl.def] VTK_OPENGL_HAS_EGL was probably overridden."
        exit 1
    fi
    echo "[backend-conda-egl.def] EGL paths + vtkEGLRenderWindow OK — proceeding to build."

    # Build with bounded parallelism. nproc on Power9 can report 128
    # (SMT4 × 32 cores) but each g++ instance for a heavy VTK template
    # peaks at ~1 GB RSS — 128 in parallel can OOM-kill cc1plus mid-
    # compile (silent failure with "ninja: build stopped" and no obvious
    # error line). Cap at min(nproc, mem_gb/2) so we leave RAM headroom.
    NPROC="$(nproc)"
    MEM_GB="$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)"
    BUILD_J="${NPROC}"
    SAFE_J="$(( MEM_GB / 2 ))"
    [ "$SAFE_J" -lt 1 ] && SAFE_J=1
    if [ "$BUILD_J" -gt "$SAFE_J" ]; then
        echo "[backend-conda-egl.def] Capping ninja parallelism: nproc=$NPROC, " \
             "mem=${MEM_GB}GB, using -j$SAFE_J for safety."
        BUILD_J="$SAFE_J"
    else
        echo "[backend-conda-egl.def] ninja -j$BUILD_J (nproc=$NPROC, mem=${MEM_GB}GB)"
    fi
    ninja -j "$BUILD_J"
    ninja install

    # Clean up source + build dir to keep the SIF small (~600 MB savings).
    cd /
    rm -rf /tmp/vtk-src /tmp/vtk-build

    # ── Stage 6 — FFmpeg + NVENC + PyAV + aiortc (optional, gated) ──
    # Enables Phase 3 of SSR: WebRTC video stream with hardware-encoded
    # H.265/H.264 instead of per-frame JPEG. Default OFF so existing
    # SSR (JPEG transport) builds stay identical in size + behaviour.
    #
    # To opt in:
    #     ENABLE_H265=1 apptainer build --fakeroot backend-egl.sif \
    #                                    apptainer/backend-conda-egl.def
    #
    # Adds ~700 MB to the SIF (custom FFmpeg in /opt/conda + PyAV
    # compiled against it + aiortc + crypto deps) and ~25 min build
    # time on a 16-core Power9.
    if [ "${ENABLE_H265:-0}" = "1" ]; then
        echo "[backend-conda-egl.def] Stage 6/6 — H.265 / NVENC / PyAV / aiortc"

        # 6a. Build dependencies. nasm/yasm are x86-only; on ppc64le
        # FFmpeg uses the GNU assembler that comes with binutils — no
        # separate assembler install needed. libx264-dev provides the
        # software H.264 fallback path for backends without an NVENC
        # GPU; the encoder selection is runtime so both are linked in.
        apt-get update
        apt-get install -y --no-install-recommends \
            libx264-dev \
            libssl-dev
        rm -rf /var/lib/apt/lists/*

        # 6b. nv-codec-headers — FFmpeg's wrapper for the NVENC SDK.
        # They are pure C headers (no asm, no NVIDIA binaries), so the
        # arch doesn't matter; we always pin to a tag that matches the
        # NVIDIA driver series deployed on the cluster (12.x ↔ driver
        # 525+). NVENC runtime requires libnvidia-encode.so at run time
        # which apptainer --nv (or our explicit binds) provides from
        # the host.
        echo "[backend-conda-egl.def] Stage 6b — nv-codec-headers"
        cd /tmp
        git clone --depth 1 --branch n12.1.14.0 \
            https://github.com/FFmpeg/nv-codec-headers.git
        cd nv-codec-headers
        make PREFIX=/usr/local install
        cd /
        rm -rf /tmp/nv-codec-headers

        # 6c. FFmpeg from source — required because:
        #   * Debian ppc64le's FFmpeg apt package is build WITHOUT
        #     --enable-nvenc (Debian's NonFree policy)
        #   * conda-forge's FFmpeg, when it has a ppc64le build at all,
        #     omits NVENC for the same licensing reason
        # We build the minimum we need (h264 + hevc encode, NVENC, x264
        # software fallback, shared libs for PyAV linkage).
        echo "[backend-conda-egl.def] Stage 6c — FFmpeg from source (NVENC + libx264)"
        FFMPEG_TAG="${FFMPEG_TAG:-n6.1.1}"
        cd /tmp
        git clone --depth 1 --branch "$FFMPEG_TAG" \
            https://git.ffmpeg.org/ffmpeg.git ffmpeg-src
        cd ffmpeg-src
        PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}" \
        ./configure \
            --prefix=/opt/conda \
            --enable-shared \
            --disable-static \
            --enable-nonfree \
            --enable-gpl \
            --enable-libx264 \
            --enable-nvenc \
            --extra-cflags=-I/usr/local/include \
            --extra-ldflags=-L/usr/local/lib \
            --disable-doc \
            --disable-ffplay \
            --disable-debug \
            2>&1 | tail -40
        # Sanity-check NVENC actually got enabled — without this, the
        # build silently falls back to libx264-only and we don't notice
        # until the spike fails at runtime.
        if ! grep -qE "Enabled encoders.*(hevc_nvenc|h264_nvenc)" config.log \
            && ! grep -qE "hevc_nvenc|h264_nvenc" ffbuild/config.mak; then
            echo "[backend-conda-egl.def] FATAL: NVENC not enabled by ffmpeg configure."
            echo "[backend-conda-egl.def] Inspect /tmp/ffmpeg-src/config.log for the reason."
            tail -50 ffbuild/config.log 2>/dev/null || true
            exit 1
        fi
        NPROC_FF="$(nproc)"
        MEM_GB_FF="$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)"
        SAFE_J_FF=$(( MEM_GB_FF / 2 ))
        [ "$SAFE_J_FF" -lt 1 ] && SAFE_J_FF=1
        [ "$SAFE_J_FF" -gt "$NPROC_FF" ] && SAFE_J_FF="$NPROC_FF"
        echo "[backend-conda-egl.def] FFmpeg make -j$SAFE_J_FF"
        make -j "$SAFE_J_FF" 2>&1 | tail -20
        make install
        cd /
        rm -rf /tmp/ffmpeg-src
        # FFmpeg installs its .pc files under /opt/conda/lib/pkgconfig.
        # PyAV's setup.py reads PKG_CONFIG_PATH at install time, so we
        # need it exported when pip runs below.
        export PKG_CONFIG_PATH="/opt/conda/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
        export LD_LIBRARY_PATH="/opt/conda/lib:${LD_LIBRARY_PATH:-}"

        # 6d. PyAV compiled against our FFmpeg.
        echo "[backend-conda-egl.def] Stage 6d — PyAV (compile against /opt/conda ffmpeg)"
        # ``--no-binary av`` forces compile-from-source even when a
        # wheel exists (it doesn't for ppc64le, but be explicit).
        pip install --no-cache-dir --no-binary av av

        # 6e. aiortc — WebRTC peer connection + signalling.
        # Brings in cryptography, aioice, av-dependent pieces. Pure
        # Python except cryptography which has wheels for ppc64le.
        echo "[backend-conda-egl.def] Stage 6e — aiortc"
        pip install --no-cache-dir aiortc

        # 6f. Smoke test — confirm the encoder pipeline is live in
        # the built image. We can't do an actual encode here (no GPU
        # at build time) but we verify the imports + codec registration.
        echo "[backend-conda-egl.def] Stage 6f — H.265 smoke test"
        python -c "
import av, aiortc, ssl
print(f'[h265-smoke] PyAV {av.__version__}, aiortc {aiortc.__version__}')
codecs = av.codec.codecs_available
print(f'[h265-smoke] hevc_nvenc available: {\"hevc_nvenc\" in codecs}')
print(f'[h265-smoke] h264_nvenc available: {\"h264_nvenc\" in codecs}')
print(f'[h265-smoke] libx264 available:   {\"libx264\" in codecs}')
assert 'hevc_nvenc' in codecs or 'h264_nvenc' in codecs, (
    'NVENC encoders missing from PyAV registry — FFmpeg was built '
    'without --enable-nvenc despite the configure step claiming OK. '
    'Check /tmp/ffmpeg-src/ffbuild/config.log next time.'
)
print('[h265-smoke] OK — Phase 3 transport ready.')
"
    else
        echo "[backend-conda-egl.def] Stage 6 SKIPPED (ENABLE_H265 != 1)"
    fi

    # Cleanup conda caches.
    conda clean --all --yes

    # ── Copy application source (same as backend-conda.def) ──────────
    mkdir -p /app
    cp -r "$SRC_DIR"/* /app/

    # ── Sanity check ─────────────────────────────────────────────────
    # NOTE on import path: in VTK 9.3 vtkEGLRenderWindow lives inside
    # the vtkRenderingOpenGL2 module (it's a sibling class of the
    # X11/Cocoa render windows in the same module, conditional on the
    # VTK_OPENGL_HAS_EGL flag at build time). There is NO separate
    # vtkmodules.vtkRenderingEGL submodule. We probe both — VTK 9.0/9.1
    # had it under vtkRenderingEGL, so the dual-import keeps the same
    # check working across the version range we deploy on.
    python -c "
import sys
print(f'[sanity] python {sys.version}')
import vtk
print(f'[sanity] vtk {vtk.VTK_VERSION}')

# Locate vtkEGLRenderWindow — try the 9.3 location first, then the
# legacy 9.0/9.1 fallback.
EGL_class = None
for path in (
    'vtkmodules.vtkRenderingOpenGL2',
    'vtkmodules.vtkRenderingEGL',
):
    try:
        mod = __import__(path, fromlist=['vtkEGLRenderWindow'])
        EGL_class = getattr(mod, 'vtkEGLRenderWindow', None)
        if EGL_class is not None:
            print(f'[sanity] vtkEGLRenderWindow found in {path}')
            break
    except ImportError as e:
        print(f'[sanity] {path} not importable: {e}')

if EGL_class is None:
    print('[sanity] FATAL: vtkEGLRenderWindow not available in any module')
    sys.exit(1)

# Verify libvtkRenderingOpenGL2 actually links against libEGL — if it
# doesn't, the EGL class is present but won't work at runtime.
import subprocess
out = subprocess.check_output(
    ['ldd', '/opt/conda/lib/libvtkRenderingOpenGL2-9.3.so'], text=True,
)
if 'libEGL' in out:
    print('[sanity] libvtkRenderingOpenGL2 links to libEGL → ✓')
else:
    print('[sanity] WARN: libvtkRenderingOpenGL2 does NOT link to libEGL')
    print('[sanity] ldd output:')
    print(out)

import numpy, scipy, astropy, healpy, numba
print(f'[sanity] numpy {numpy.__version__}, scipy {scipy.__version__}, '
      f'astropy {astropy.__version__}, healpy {healpy.__version__}, '
      f'numba {numba.__version__}')
print('[sanity] Full conda+EGL VTK stack verified.')
"

%setup
    set -ex
    SRC_HOST="${PWD}/backend"
    SRC_TGT="${APPTAINER_ROOTFS}/srv/backend_src"
    if [ ! -d "$SRC_HOST" ]; then
        echo "ERROR: ${SRC_HOST} not found. Run build from repo root."
        exit 1
    fi
    mkdir -p "$SRC_TGT"
    cp -r "$SRC_HOST"/. "$SRC_TGT/"

%runscript
    #!/bin/bash
    HOST="${VISIVO_HOST:-0.0.0.0}"
    PORT="${PORT:-8000}"
    WORKERS="${VISIVO_WORKERS:-$(nproc)}"
    echo "[VisIVO/conda-egl] Starting backend on ${HOST}:${PORT} "\
         "with ${WORKERS} worker(s); VTK headless EGL backend."
    exec uvicorn app.main:app \
        --host "${HOST}" \
        --port "${PORT}" \
        --workers 1 \
        --log-level info \
        --app-dir /app

%test
    python -c "
import sys, platform
sys.path.insert(0, '/app')
from app.auth import TOKEN
from app.sessions import REGISTRY
print(f'[test] Architecture: {platform.machine()}')
print(f'[test] Python: {sys.version.split()[0]}')
print(f'[test] Auth module OK. Token length: {len(TOKEN)}')

# EGL-specific probes — what differs from the X11 build. In VTK 9.3
# vtkEGLRenderWindow lives inside vtkRenderingOpenGL2 (conditional on
# the VTK_OPENGL_HAS_EGL build flag), NOT in a separate vtkRenderingEGL
# submodule. We probe both paths for forward+backward compatibility.
import vtk
print(f'[test] vtk {vtk.VTK_VERSION}')

EGL_class = None
for path in ('vtkmodules.vtkRenderingOpenGL2', 'vtkmodules.vtkRenderingEGL'):
    try:
        mod = __import__(path, fromlist=['vtkEGLRenderWindow'])
        EGL_class = getattr(mod, 'vtkEGLRenderWindow', None)
        if EGL_class is not None:
            print(f'[test] vtkEGLRenderWindow imported from {path} → ✓')
            break
    except ImportError as e:
        print(f'[test] {path} not importable: {e}')

if EGL_class is None:
    print('[test] FATAL: vtkEGLRenderWindow not in any expected module')
    sys.exit(1)

# Try to instantiate (but do NOT call Render — at build time we have
# no GPU; --nv runtime supplies it). The constructor's call to
# eglGetDisplay can succeed with EGL_NO_DISPLAY in a CI/build env.
win = EGL_class()
win.SetOffScreenRendering(1)
print(f'[test] Created vtkEGLRenderWindow offscreen instance: {type(win).__name__}')

import numpy, scipy, astropy, healpy, numba
print(f'[test] scientific stack OK: numpy={numpy.__version__} '
      f'scipy={scipy.__version__} astropy={astropy.__version__} '
      f'healpy={healpy.__version__} numba={numba.__version__}')
print('[test] Full EGL-enabled VTK + conda stack verified.')
"
