Bootstrap: localimage
From: backend-conda.sif

%labels
    Maintainer VisIVOLab <visivo@inaf.it>
    Version    1.1.0-conda-egl
    Description VisIVO Backend (conda image + VTK 9.3.1 built with EGL) — server-side rendering on ppc64le / x86_64

%help
    The conda image (backend-conda.def) with VTK rebuilt from source with
    EGL, so the backend can render a cube on the node's GPU with no display
    and send the frames instead of a decimated copy of the cube.

    Why a rebuild: conda-forge publishes only the Qt/X11 build of VTK for
    linux-ppc64le (9.2.6, 9.3.0, 9.3.1); the EGL and OSMesa variants exist
    for linux-64 only. A backend without vtkEGLRenderWindow reports
    server-side rendering as unavailable, and the client then renders a
    decimated proxy of the cube locally.

    A layer on the conda image, not a copy of its recipe: the scientific
    stack, SoFiA-2, CuPy and the application are those of the base, and
    this file only swaps VTK.

    ── Build ────────────────────────────────────────────────────────────
    # In the directory that holds the conda image, named backend-conda.sif
    # (a symlink is fine), with the definition from a VisIVO checkout:
    ln -sf backend-conda-gpu.sif backend-conda.sif
    apptainer build --force --fakeroot backend-egl.sif VisIVO/apptainer/backend-conda-egl.def

    (--force: without it Apptainer keeps the base image's help and labels.)

    About 70-90 min on 16 POWER9 cores; VTK dominates. VTK_TAG (default
    v9.3.1) selects the source tag: APPTAINERENV_VTK_TAG=v9.3.1.

    ── Run ──────────────────────────────────────────────────────────────
    scripts/launch_backend_slurm.sh --sif backend-egl.sif ... binds the
    host's NVIDIA EGL libraries and glvnd vendor file, which Apptainer's
    --nv misses on some ppc64le installs.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # As in the base image: the backend's stack is the visivo environment.
    export PATH=/opt/conda/envs/visivo/bin:/opt/conda/bin:${PATH}
    export VISIVO_SESSION_TTL=${VISIVO_SESSION_TTL:-1800}
    # libglvnd picks the NVIDIA EGL vendor, not Mesa's software one.
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

%post
    set -e
    ENV_PREFIX=/opt/conda/envs/visivo
    PY="$ENV_PREFIX/bin/python"
    VTK_TAG="${VTK_TAG:-v9.3.1}"
    echo "[backend-conda-egl.def] VTK_TAG=$VTK_TAG"

    # ── 1. Compilers and the EGL/GL headers (apt) ─────────────────────
    # Mesa's EGL/GL development packages are not on conda-forge for
    # ppc64le. They provide the headers and libglvnd's libEGL.so to link
    # against; at run time the host's NVIDIA libraries are bound in.
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git pkg-config \
        libegl-dev libegl1 libgl-dev libopengl-dev libglvnd-dev
    rm -rf /var/lib/apt/lists/*

    EGL_LIBDIR="/usr/lib/$(gcc -print-multiarch)"
    EGL_LIB="$EGL_LIBDIR/libEGL.so"
    [ -e "$EGL_LIB" ] || ln -sf libEGL.so.1 "$EGL_LIB"
    for f in "$EGL_LIB" "$EGL_LIBDIR/libOpenGL.so" /usr/include/EGL/egl.h /usr/include/KHR/khrplatform.h; do
        [ -e "$f" ] || { echo "[backend-conda-egl.def] FATAL: $f missing"; exit 1; }
    done

    # The vendor file the environment points at. The launcher binds the
    # host's over it; this one names the same library, for runners that
    # do not.
    mkdir -p /usr/share/glvnd/egl_vendor.d
    if [ ! -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
        printf '%s\n' '{' '    "file_format_version" : "1.0.0",' \
            '    "ICD" : { "library_path" : "libEGL_nvidia.so.0" }' '}' \
            > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
    fi

    # ── 2. Drop conda-forge's X11 VTK and its OpenGL stack ────────────
    # --force: remove these packages only, not what depends on them; the
    # source build below provides the same vtkmodules package.
    #
    # The X11 VTK brought conda's own libglvnd (libGLdispatch, libOpenGL,
    # libGL, libGLX) and the libraries that need it. Left in the env, its
    # libGLdispatch is found through the env's RPATHs while libEGL comes
    # from the host (--nv): two dispatch libraries in one process, and the
    # first GL call crashed inside the NVIDIA driver on PLEIADI-GPU. With
    # them gone, the env provides none of them, so under --nv the loader
    # takes all three from the host's glvnd, as long as Apptainer's
    # nvliblist exposes all three (it does on PLEIADI-GPU).
    . /opt/conda/etc/profile.d/conda.sh
    conda remove -y --force -p "$ENV_PREFIX" vtk vtk-base vtk-io-ffmpeg \
        gl2ps glew libglu libgl libglx libopengl libegl libglvnd || true
    for lib in libGLdispatch.so.0 libOpenGL.so.0 libEGL.so.1 libGL.so.1 libGLX.so.0; do
        [ ! -e "$ENV_PREFIX/lib/$lib" ] \
            || { echo "[backend-conda-egl.def] FATAL: conda's $lib is still in the env"; exit 1; }
    done
    if "$PY" -c "import vtkmodules" 2>/dev/null; then
        echo "[backend-conda-egl.def] FATAL: conda's vtkmodules is still importable"
        exit 1
    fi

    # ── 3. VTK from source, headless with EGL ─────────────────────────
    # Every -D carries its :TYPE, or CMake stores it UNINITIALIZED and
    # VTK's options never see it. Desktop OpenGL through EGL, not GLES: on
    # PLEIADI-GPU (V100, driver 550.54.15) a GLES build crashed inside the
    # NVIDIA driver on the first GL call after the context was made
    # (vtkOpenGLState::Initialize). The cell-grid and LIC modules stay off:
    # the backend renders volumes and slices only.
    rm -rf /tmp/vtk-src /tmp/vtk-build
    git clone --depth 1 --branch "$VTK_TAG" https://gitlab.kitware.com/vtk/vtk.git /tmp/vtk-src
    mkdir -p /tmp/vtk-build
    cd /tmp/vtk-build
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE:STRING=Release \
        -DCMAKE_INSTALL_PREFIX:PATH="$ENV_PREFIX" \
        -DCMAKE_INSTALL_LIBDIR:STRING=lib \
        -DBUILD_SHARED_LIBS:BOOL=ON \
        -DBUILD_TESTING:BOOL=OFF \
        -DBUILD_EXAMPLES:BOOL=OFF \
        -DVTK_USE_X:BOOL=OFF \
        -DVTK_USE_COCOA:BOOL=OFF \
        -DVTK_OPENGL_HAS_EGL:BOOL=ON \
        -DVTK_OPENGL_HAS_OSMESA:BOOL=OFF \
        -DVTK_OPENGL_USE_GLES:BOOL=OFF \
        -DVTK_DEFAULT_RENDER_WINDOW_HEADLESS:BOOL=ON \
        -DOpenGL_GL_PREFERENCE:STRING=GLVND \
        -DOPENGL_opengl_LIBRARY:FILEPATH="$EGL_LIBDIR/libOpenGL.so" \
        -DOPENGL_egl_LIBRARY:FILEPATH="$EGL_LIB" \
        -DOPENGL_EGL_INCLUDE_DIR:PATH=/usr/include \
        -DEGL_INCLUDE_DIR:PATH=/usr/include \
        -DEGL_LIBRARY:FILEPATH="$EGL_LIB" \
        -DVTK_WRAP_PYTHON:BOOL=ON \
        -DVTK_PYTHON_VERSION:STRING=3 \
        -DPython3_EXECUTABLE:FILEPATH="$PY" \
        -DVTK_GROUP_ENABLE_StandAlone:STRING=YES \
        -DVTK_GROUP_ENABLE_Rendering:STRING=YES \
        -DVTK_GROUP_ENABLE_Imaging:STRING=YES \
        -DVTK_GROUP_ENABLE_Views:STRING=YES \
        -DVTK_GROUP_ENABLE_MPI:STRING=DONT_WANT \
        -DVTK_GROUP_ENABLE_Qt:STRING=DONT_WANT \
        -DVTK_GROUP_ENABLE_Web:STRING=DONT_WANT \
        -DVTK_MODULE_ENABLE_VTK_RenderingVolume:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingVolumeOpenGL2:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingOpenGL2:STRING=YES \
        -DVTK_MODULE_ENABLE_VTK_RenderingLICOpenGL2:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_RenderingCellGrid:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_FiltersCellGrid:STRING=NO \
        -DVTK_MODULE_ENABLE_VTK_IOCellGrid:STRING=NO \
        /tmp/vtk-src 2>&1 | tee /tmp/vtk-cmake.log
    # A configure that quietly dropped EGL still builds; refuse it here.
    grep -qE "^OPENGL_egl_LIBRARY:FILEPATH=.+libEGL" CMakeCache.txt \
        || { echo "[backend-conda-egl.def] FATAL: OPENGL_egl_LIBRARY not in the cache"; exit 1; }
    grep -qE "^OPENGL_opengl_LIBRARY:FILEPATH=.+libOpenGL" CMakeCache.txt \
        || { echo "[backend-conda-egl.def] FATAL: OPENGL_opengl_LIBRARY not in the cache"; exit 1; }
    grep -qi "vtkEGLRenderWindow" build.ninja \
        || { echo "[backend-conda-egl.def] FATAL: vtkEGLRenderWindow is not built"; exit 1; }

    # One heavy C++ unit can take 1 GB: cap the jobs at half the memory in GB.
    JOBS="$(nproc)"
    SAFE="$(awk '/MemTotal/ {printf "%d", $2/1024/1024/2}' /proc/meminfo)"
    [ "$SAFE" -ge 1 ] || SAFE=1
    [ "$JOBS" -le "$SAFE" ] || JOBS="$SAFE"
    echo "[backend-conda-egl.def] ninja -j$JOBS"
    ninja -j "$JOBS"
    ninja install
    cd /
    rm -rf /tmp/vtk-src /tmp/vtk-build
    conda clean --all --yes

    # ── 4. Check what was built ───────────────────────────────────────
    "$PY" - <<'EOF'
import glob, subprocess, sys
import vtk
from vtkmodules import vtkRenderingOpenGL2 as gl
print(f"[backend-conda-egl.def] vtk {vtk.VTK_VERSION} from {vtk.__file__}")
if not hasattr(gl, "vtkEGLRenderWindow"):
    sys.exit("[backend-conda-egl.def] FATAL: no vtkEGLRenderWindow")
lib = glob.glob("/opt/conda/envs/visivo/lib/libvtkRenderingOpenGL2-*.so")[0]
if "libEGL" not in subprocess.check_output(["ldd", lib], text=True):
    sys.exit(f"[backend-conda-egl.def] FATAL: {lib} does not link libEGL")
print("[backend-conda-egl.def] vtkEGLRenderWindow present, linked to libEGL")
EOF

%test
    /opt/conda/envs/visivo/bin/python - <<'EOF'
import sys
sys.path.insert(0, "/app")
import vtk
from vtkmodules import vtkRenderingOpenGL2 as gl
print(f"[test] vtk {vtk.VTK_VERSION}, vtkEGLRenderWindow: {hasattr(gl, 'vtkEGLRenderWindow')}")
from app.render_session import server_side_rendering_available
print(f"[test] server_side_rendering_available: {server_side_rendering_available()}")
assert server_side_rendering_available(), "the backend would not offer server-side rendering"
import numpy, astropy, numba
print(f"[test] numpy {numpy.__version__}, astropy {astropy.__version__}, numba {numba.__version__}")
import shutil
print(f"[test] SoFiA-2: {shutil.which('sofia') or 'not installed'}")
try:
    import cupy
    print(f"[test] cupy {cupy.__version__}")
except ImportError:
    print("[test] cupy not installed")
EOF
