Bootstrap: docker
From: python:3.12-slim

%labels
    Maintainer VisIVOLab <visivo@inaf.it>
    Version    1.0.0
    Description VisIVO Backend – astrophysical data visualization server

%help
    Apptainer/Singularity image for the VisIVO backend (FastAPI + astropy + VTK).

    ── Quick start ──────────────────────────────────────────────────────────────
    # Build (RUN FROM REPO ROOT — paths in %files are relative to cwd)
    cd VisIVO-next
    apptainer build --fakeroot backend.sif apptainer/backend.def

    # Run (token auto-generated and printed to stdout)
    apptainer run --bind /path/to/data:/data backend.sif

    # Run with a fixed token (recommended for scripted deployments)
    VISIVO_TOKEN=mysecrettoken apptainer run --bind /path/to/data:/data backend.sif

    # Run on a non-standard port
    PORT=9000 apptainer run backend.sif

    ── HPC / SLURM ──────────────────────────────────────────────────────────────
    Use scripts/launch_backend_slurm.sh to submit a SLURM job that starts this
    container on a compute node and prints the SSH tunnel command.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Worker processes for CPU-bound FITS/VTK operations (default: nproc)
    export VISIVO_WORKERS=${VISIVO_WORKERS:-0}
    # Session idle-timeout in seconds (default 30 min)
    export VISIVO_SESSION_TTL=${VISIVO_SESSION_TTL:-1800}

%post
    set -e

    # ── System deps ──────────────────────────────────────────────────────────
    # Build-time toolchain for any scientific package that ships only an
    # sdist for ppc64le (numba, healpy, photutils' C extensions, scipy).
    # On x86_64 most wheels are pre-built so these are unused; on ppc64le
    # they save the build from failing on missing compilers / BLAS / HDF5.
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        gfortran \
        make \
        automake \
        autoconf \
        libtool \
        cmake \
        llvm-15-dev \
        libffi-dev \
        libssl-dev \
        libhdf5-dev \
        libopenblas-dev \
        liblapack-dev \
        libfftw3-dev \
        libcfitsio-dev \
        pkg-config \
        && rm -rf /var/lib/apt/lists/*

    # llvmlite is pinned to 0.43.* below (the last release that supports
    # LLVM 15, which is what we just installed via llvm-15-dev). Force
    # llvm-config to point at the v15 binary so llvmlite's setup.py and
    # CMakeLists.txt both find the right LLVM headers — even if a higher
    # llvm-config-NN binary happens to be on PATH.
    if [ -x /usr/bin/llvm-config-15 ]; then
        ln -sf /usr/bin/llvm-config-15 /usr/bin/llvm-config
        echo "[backend.def] /usr/bin/llvm-config → llvm-config-15"
    elif command -v llvm-config >/dev/null 2>&1; then
        echo "[backend.def] WARN: llvm-config-15 missing, using existing $(which llvm-config)"
    else
        LLVMC=$(ls /usr/bin/llvm-config-* 2>/dev/null | sort -V | tail -1 || true)
        if [ -n "$LLVMC" ]; then
            ln -sf "$LLVMC" /usr/bin/llvm-config
            echo "[backend.def] Symlinked $LLVMC → /usr/bin/llvm-config"
        else
            echo "[backend.def] WARN: no llvm-config-* found in /usr/bin"
        fi
    fi
    export LLVM_CONFIG=/usr/bin/llvm-config
    llvm-config --version || echo "[backend.def] WARN: llvm-config still not callable"

    # ── Python deps ──────────────────────────────────────────────────────────
    pip install --no-cache-dir --upgrade pip

    # ─── Locate the requirements file ─────────────────────────────────────
    # Apptainer's %files block normally places ``backend`` into
    # ``/srv/backend_src``, but the exact resulting layout depends on
    # how the source was specified (with or without trailing slash) and
    # whether the destination existed beforehand. Be defensive: find the
    # ``requirements.txt`` wherever Apptainer ended up putting it, then
    # use its parent directory as the source root.
    REQS=$(find /srv/backend_src -name requirements.txt -print -quit 2>/dev/null)
    if [ -z "$REQS" ]; then
        echo "ERROR: requirements.txt not found anywhere under /srv/backend_src"
        echo "Listing /srv/backend_src contents (depth 3):"
        ls -la /srv/backend_src/ || true
        find /srv/backend_src -maxdepth 3 -type f | head -40 || true
        exit 1
    fi
    SRC_DIR=$(dirname "$REQS")
    echo "[backend.def] Source root resolved to: $SRC_DIR"

    # ─── Architecture-aware install ───────────────────────────────────────
    # The desktop client needs VTK Python bindings; the backend uses VTK
    # only inside one function (worker_isosurface) which is guarded by a
    # lazy import. Since VTK has no ppc64le wheel on PyPI and building it
    # from source would take ~1h, we filter it out of the requirements
    # list for the apptainer build. The /v1/cube/isosurface endpoint will
    # then surface a clear "VTK not installed" error if called; every
    # other endpoint (image, cube, moments, dynspec, region stats, etc.)
    # works without VTK because the heavy lifting happens via
    # vtkFlyingEdges3D only for isosurfacing.
    REQS_FILTERED=/srv/requirements-no-vtk.txt
    grep -v '^vtk' "$REQS" > "$REQS_FILTERED"
    echo "[backend.def] Installing from filtered requirements:"
    cat "$REQS_FILTERED"

    # ─── llvmlite ppc64le handling ────────────────────────────────────────
    # Two layered problems on ppc64le:
    #
    # 1. No prebuilt wheel — llvmlite must compile against the system
    #    LLVM dev headers. The version is strict 1:1 with LLVM major:
    #      llvmlite 0.44 ↔ LLVM 17
    #      llvmlite 0.45 ↔ LLVM 18-19   (Debian trixie default — what we have)
    #      llvmlite 0.46 ↔ LLVM 20      (would need apt.llvm.org repo)
    #      llvmlite 0.47 ↔ LLVM 20
    #
    # 2. llvmlite's older build code uses ``setuptools.Distribution.spawn(
    #    dry_run=…)`` which setuptools 70+ removed, so the wheel build
    #    crashes with ``TypeError: spawn() got an unexpected keyword
    #    argument 'dry_run'`` if pip's normal PEP-517 build isolation
    #    fetches a fresh setuptools≥70.
    #
    # Workaround: pre-install setuptools<70 system-wide, then build
    # llvmlite alone with ``--no-build-isolation`` so it reuses our
    # pinned setuptools instead of fetching the latest one. Every other
    # package keeps normal build isolation (which is what they want).
    pip install --no-cache-dir "setuptools<70" "wheel" "cython"

    # Build llvmlite 0.46 against system LLVM 19, reusing the older
    # setuptools we just installed.
    pip install --no-cache-dir --no-build-isolation "llvmlite==0.45.*"

    # Now install the full requirements set. pip sees llvmlite already
    # satisfied at 0.46 and skips it. The constraint file additionally
    # protects against any transitive dep trying to pull a newer
    # llvmlite (which would fail again on LLVM mismatch).
    CONSTRAINTS=/srv/constraints-ppc64le.txt
    cat > "$CONSTRAINTS" <<EOF
llvmlite==0.45.*
EOF
    echo "[backend.def] ppc64le pip constraints:"
    cat "$CONSTRAINTS"

    pip install --no-cache-dir -c "$CONSTRAINTS" -r "$REQS_FILTERED"

    # ─── Optional: dask[distributed] for cross-node parallelism ───────────
    # Always installed — Power9 SRC testbed scenarios use it to spread
    # heavy compute across N nodes via VISIVO_DASK_SCHEDULER. Pure Python,
    # zero cost when unused.
    pip install --no-cache-dir "dask[distributed]>=2024.1.0"

    # ─── Optional: cupy (NVIDIA GPU) ──────────────────────────────────────
    # Set ENABLE_CUPY=1 in the build environment to install cupy. Power9
    # + V100/A100 via NVLink is the flagship use case and gives 10-50×
    # speedups for moment maps / channel maps on multi-GB cubes. cupy has
    # no wheel on PyPI for ppc64le, but conda-forge does — we use the
    # pre-built ppc64le wheel from rapids.ai's nightly index. Requires
    # CUDA runtime libraries on the host (the container links against
    # libcudart at runtime via --nv flag of apptainer).
    if [ "${ENABLE_CUPY:-0}" = "1" ]; then
        echo "[backend.def] ENABLE_CUPY=1 → installing cupy-cuda12x for ppc64le"
        pip install --no-cache-dir \
            --extra-index-url https://pypi.anaconda.org/rapidsai-wheels-nightly/simple \
            cupy-cuda12x || \
        echo "[backend.def] WARN: cupy install failed — GPU acceleration disabled"
    else
        echo "[backend.def] ENABLE_CUPY not set → skipping GPU acceleration"
    fi

    # ── Copy application source ───────────────────────────────────────────────
    mkdir -p /app
    cp -r "$SRC_DIR"/* /app/

    # ── Sanity check ─────────────────────────────────────────────────────────
    python -c "import fastapi, astropy, numpy; print('Import OK')"

%setup
    # %setup runs on the HOST (not inside the container being built) with
    # direct access to the host filesystem via ${PWD} and to the
    # in-progress container rootfs via ${APPTAINER_ROOTFS} (or
    # ${SINGULARITY_ROOTFS} on older versions).
    #
    # Using %setup instead of %files avoids the path-resolution problems
    # we've seen with Apptainer 1.x not finding relative sources from
    # the %files block when the cp is invoked from inside the build
    # sandbox.
    #
    # Sources are resolved in this order:
    #   1. $VISIVO_BACKEND_SRC env var (highest priority — set this
    #      to an absolute path before ``apptainer build`` if the
    #      auto-detection below ever fails)
    #   2. ${PWD}/backend  (build launched from repo root — recommended)
    #   3. ${PWD}/../backend (build launched from apptainer/ subdir)
    #
    # Recommended invocation:
    #   cd VisIVO-next                 # repo root
    #   apptainer build --fakeroot backend.sif apptainer/backend.def
    #
    # If %setup isn't honored (some Apptainer security profiles disallow
    # host-side scripts), the fallback is to pre-stage manually:
    #   sudo cp -r backend /tmp/visivo_backend_src
    # and set VISIVO_BACKEND_SRC=/tmp/visivo_backend_src.
    set -ex
    ROOTFS="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    if [ -z "$ROOTFS" ]; then
        echo "########## ERROR ##########"
        echo "Neither APPTAINER_ROOTFS nor SINGULARITY_ROOTFS is set."
        echo "Your Apptainer version may have disabled %setup; try:"
        echo "  apptainer build --fakeroot --no-mount tmp backend.sif apptainer/backend.def"
        echo "or downgrade to a release that supports host-side %setup."
        echo "###########################"
        exit 1
    fi
    SRC="${VISIVO_BACKEND_SRC:-}"
    if [ -z "$SRC" ] || [ ! -d "$SRC" ]; then
        if [ -d "${PWD}/backend" ]; then
            SRC="${PWD}/backend"
        elif [ -d "${PWD}/../backend" ]; then
            SRC="${PWD}/../backend"
        else
            echo "########## ERROR ##########"
            echo "backend/ source directory not found."
            echo "Tried (in order):"
            echo "  \$VISIVO_BACKEND_SRC = '${VISIVO_BACKEND_SRC:-(unset)}'"
            echo "  ${PWD}/backend"
            echo "  ${PWD}/../backend"
            echo ""
            echo "Fix: cd to the repo root before running apptainer build,"
            echo "or export VISIVO_BACKEND_SRC=/absolute/path/to/backend."
            echo "###########################"
            exit 1
        fi
    fi
    echo "[%setup] PWD=${PWD}"
    echo "[%setup] Staging backend source from: $SRC"
    echo "[%setup] Target rootfs: $ROOTFS"
    mkdir -p "$ROOTFS/srv/backend_src"
    cp -r "$SRC"/. "$ROOTFS/srv/backend_src/"
    echo "[%setup] Top-level files staged:"
    ls -la "$ROOTFS/srv/backend_src/" | head -20
    if [ ! -f "$ROOTFS/srv/backend_src/requirements.txt" ]; then
        echo "########## ERROR ##########"
        echo "requirements.txt NOT FOUND after copy. cp may have failed silently."
        echo "Source was: $SRC"
        echo "Source listing:"
        ls -la "$SRC" | head -20
        echo "###########################"
        exit 1
    fi
    echo "[%setup] OK — requirements.txt present, %post can proceed."

%runscript
    #!/bin/bash
    HOST="${VISIVO_HOST:-0.0.0.0}"
    PORT="${PORT:-8000}"
    WORKERS="${VISIVO_WORKERS:-$(nproc)}"

    echo "[VisIVO] Starting backend on ${HOST}:${PORT} with ${WORKERS} worker(s)"

    exec uvicorn app.main:app \
        --host "${HOST}" \
        --port "${PORT}" \
        --workers 1 \
        --log-level info \
        --app-dir /app

%test
    python -c "
import sys, platform
sys.path.insert(0, '/app')
from app.auth import TOKEN
from app.sessions import REGISTRY
print(f'[test] Architecture: {platform.machine()}')
print(f'[test] Auth module OK. Token length: {len(TOKEN)}')
print(f'[test] Sessions module OK.')
# Smoke test the scientific stack
import numpy, scipy, astropy, healpy
print(f'[test] numpy {numpy.__version__}, scipy {scipy.__version__}, '
      f'astropy {astropy.__version__}, healpy {healpy.__version__}')
# VTK is optional on this build (no ppc64le wheel) — the isosurface
# endpoint is the only consumer and surfaces a clear error if called.
try:
    import vtk
    print(f'[test] vtk {vtk.vtkVersion.GetVTKVersion()} available')
except ImportError:
    print('[test] vtk not installed — isosurface endpoint disabled, '
          'every other endpoint works normally.')
print('[test] All checks passed.')
"
