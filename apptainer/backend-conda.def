Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Maintainer VisIVOLab <visivo@inaf.it>
    Version    1.0.0-conda
    Description VisIVO Backend (conda-forge variant) — full scientific stack incl. numba/vtk on ppc64le

%help
    Apptainer image for the VisIVO backend, built on top of
    condaforge/mambaforge. This variant uses conda-forge channels
    instead of PyPI, which provides pre-built binary packages for
    ppc64le (and x86_64/aarch64) for the full scientific stack —
    including the ones with no PyPI wheels on Power9:

        * llvmlite + numba   (LLVM JIT, no LLVM version juggling)
        * vtk                (rendering bindings, full)
        * scipy / healpy     (BLAS-linked builds)
        * cupy (optional)    (NVIDIA GPU, no manual CUDA install needed)

    The image is larger (~1.5 GB vs ~600 MB for backend.def) but the
    build is much faster (~5 min vs ~30 min) and includes everything,
    so prefer this variant for SRC node deployments unless you need
    the smaller image footprint.

    ── Quick start ──────────────────────────────────────────────────────
    # Build (RUN FROM REPO ROOT — paths in %setup are relative to cwd)
    cd VisIVOVisualAnalytics
    apptainer build --fakeroot backend.sif apptainer/backend-conda.def

    # Default uses ``conda install --no-lock`` (libmamba solver, no
    # lockfile contention — safest on Power9 shared filesystems).
    # For maximum speed on a single-host build, switch to mamba. Note
    # the APPTAINERENV_ prefix: Apptainer scrubs unprefixed env vars
    # in the %post section, so a plain ``CONDA_INSTALLER=mamba``
    # would be ignored.
    APPTAINERENV_CONDA_INSTALLER=mamba \
        apptainer build --fakeroot backend.sif apptainer/backend-conda.def

    # Build with NVIDIA GPU support (cupy)
    # (APPTAINERENV_ prefix: Apptainer passes only prefixed variables into
    # %post; a plain ENABLE_CUPY=1 is silently ignored.)
    APPTAINERENV_ENABLE_CUPY=1 apptainer build --fakeroot backend.sif apptainer/backend-conda.def

    # Run
    apptainer run --bind /path/to/data:/data backend.sif

    # Run with GPU passthrough
    apptainer run --nv --bind /path/to/data:/data backend.sif

    # Run on a non-standard port
    PORT=9000 apptainer run backend.sif

    ── HPC / SLURM ──────────────────────────────────────────────────────
    To run inside a SLURM cluster (e.g. the Power9 testbed where the
    login node is pleiadi-gpu.oact.inaf.it and you should NOT keep a
    long-lived backend on the frontend), use the SLURM submission
    helper:

        # On the frontend, after building backend-gpu.sif on the cluster:
        bash scripts/launch_backend_slurm.sh \\
            --partition gpu --gres gpu:1 \\
            --data-root /data \\
            --sif ~/VisIVOVisualAnalytics/backend-gpu.sif

    Or, drive it remotely from your laptop in a single command:

        # On your Mac/Linux desktop:
        bash scripts/visivo_slurm_tunnel.sh \\
            --frontend pleiadi-gpu.oact.inaf.it --user fvitello \\
            --partition gpu --gres gpu:1 --data-root /data \\
            --sif ~/VisIVOVisualAnalytics/backend-gpu.sif

    The latter submits the job, opens the SSH tunnel, and prints the
    Remote Backend settings ready to paste into VisIVO desktop.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Ensure the conda environment's binaries take precedence — mambaforge
    # puts conda itself under /opt/conda/bin; the backend's stack lives in
    # its own environment, /opt/conda/envs/visivo, first on the PATH.
    export PATH=/opt/conda/envs/visivo/bin:/opt/conda/bin:${PATH}
    # Worker processes for CPU-bound FITS/VTK operations. We deliberately
    # do NOT export a default here — the backend's ``app/dependencies.py``
    # uses ``int(os.environ.get('VISIVO_WORKERS', '4'))`` and would
    # crash on ``ProcessPoolExecutor(max_workers=0)`` if we set 0 here.
    # Users can still override at runtime with VISIVO_WORKERS=<N>.
    # Session idle-timeout in seconds (default 30 min)
    export VISIVO_SESSION_TTL=${VISIVO_SESSION_TTL:-1800}

    # ─── Compute-next-to-data path jail ────────────────────────────────
    # When set, the /v1/datasets/open_skava endpoint refuses to open
    # files outside this directory tree. The desktop client supplies
    # the file:// URL it got from SKAVA; this jail is the second line
    # of defence against client-side path traversal.
    #
    # Example:
    #   APPTAINERENV_VISIVO_DATA_ROOT=/data \\
    #       apptainer run --bind /data:/data backend.sif

%post
    set -e

    # ── Source the conda activate hook ─────────────────────────────────────
    . /opt/conda/etc/profile.d/conda.sh
    conda activate base

    # ── Solver selection ───────────────────────────────────────────────────
    # On some Power9 testbeds mamba's internal lock contends with the
    # shared filesystem and stalls. ``conda install --no-lock`` (a
    # libmamba-solver flag) bypasses the transactional database lock and
    # is the known-good pattern in that environment.
    #
    # Default to ``conda --no-lock`` for portability; override to mamba
    # for maximum speed on a single-host build. Apptainer scrubs the
    # host environment in %post, so the variable MUST use the
    # APPTAINERENV_ prefix to propagate through:
    #     APPTAINERENV_CONDA_INSTALLER=mamba apptainer build ...
    # (Plain ``CONDA_INSTALLER=mamba apptainer build`` is silently
    # ignored — Apptainer never passes the unprefixed variable in.)
    #
    # The two installers are otherwise interchangeable, but on ppc64le
    # mamba native is dramatically faster: stages that take 20+ min
    # with ``conda install --no-lock`` complete in ~30s with mamba.
    CONDA_INSTALLER="${CONDA_INSTALLER:-conda}"
    case "$CONDA_INSTALLER" in
        mamba)
            INSTALL_CMD="mamba install -y"
            CREATE_CMD="mamba create -y"
            ;;
        conda)
            INSTALL_CMD="conda install -y --no-lock"
            CREATE_CMD="conda create -y --no-lock"
            ;;
        *)
            echo "ERROR: CONDA_INSTALLER must be 'mamba' or 'conda', got '$CONDA_INSTALLER'"
            exit 1
            ;;
    esac
    echo "[backend-conda.def] Using installer: $INSTALL_CMD"

    # ── Locate the requirements file (same logic as the slim variant) ──────
    REQS=$(find /srv/backend_src -name requirements.txt -print -quit 2>/dev/null)
    if [ -z "$REQS" ]; then
        echo "ERROR: requirements.txt not found anywhere under /srv/backend_src"
        ls -la /srv/backend_src/ || true
        exit 1
    fi
    SRC_DIR=$(dirname "$REQS")
    echo "[backend-conda.def] Source root resolved to: $SRC_DIR"

    # ── Scientific stack from conda-forge — STAGED install ─────────────────
    # Why not pip? conda-forge has pre-built binary packages for every
    # architecture it supports (incl. ppc64le), so we skip every
    # ~from-source build that bites us on the slim variant: vtk, numba,
    # llvmlite, scipy's OpenBLAS link, healpy + libsharp, h5py + HDF5.
    #
    # Why staged? Conda's libsolv segfaults on ppc64le when the
    # solver graph gets too large (observed: ~22 top-level packages
    # crashes during "Solving environment"). Splitting the install
    # into 4 smaller groups keeps each solve under that threshold —
    # once stage N is solved, those packages and all their transitive
    # deps are pinned for stage N+1, so the next solve sees a much
    # smaller search space.
    #
    # Some pkgs have slightly different names on conda-forge:
    #   pip name              → conda name
    #   ─────────────────────────────────────
    #   uvicorn[standard]     → uvicorn-standard
    #   dask[array]           → dask + distributed
    #
    # healpy <1.19 imports ``from scipy.integrate import trapz`` which
    # scipy 1.14+ removed (renamed to ``trapezoid``). On conda-forge
    # ppc64le the healpy >=1.19 binary isn't always available, so
    # pinning healpy alone is unreliable. Pin scipy<1.14 instead —
    # keeps ``trapz`` available for any healpy version the solver
    # picks, and stays well within ``scipy>=1.10`` from requirements.txt.

    # The stack goes into its own environment, ``visivo``, never into
    # ``base``: base holds conda and its solver, and installing the stack
    # there let it replace libraries the solver links against (libxml2 2.14
    # dropped libxml2.so.2, and conda-libmamba-solver could no longer load,
    # failing every later stage on ppc64le). Base stays as the image built it.
    echo "[backend-conda.def] Stage 1/4 — foundation (python, numpy, scipy<1.14, astropy, pandas, healpy)"
    $CREATE_CMD -n visivo -c conda-forge \
        python=3.12 \
        numpy \
        "scipy<1.14" \
        astropy \
        pandas \
        healpy \
        pyerfa \
        pillow \
        pip

    # Every later stage, and the SoFiA-2 source build (its compilers come
    # from this environment), runs in the backend's environment.
    conda activate visivo

    echo "[backend-conda.def] Stage 2/4 — VTK + HDF5 (rendering / I/O)"
    $INSTALL_CMD -n visivo -c conda-forge \
        vtk \
        h5py

    echo "[backend-conda.def] Stage 3/4 — Numba JIT"
    $INSTALL_CMD -n visivo -c conda-forge \
        numba \
        llvmlite

    # Stage 4 is split into sub-stages because astroquery pulls a huge
    # chain (keyring/cryptography/requests/bs4/html5lib/...) that on
    # ppc64le with the conda solver can take 25+ min and 5+ GB RAM if
    # combined with photutils/scikit-image's own dep tree. Splitting
    # keeps each solve fast and memory-bounded.
    echo "[backend-conda.def] Stage 4a — Web framework"
    $INSTALL_CMD -n visivo -c conda-forge \
        fastapi \
        uvicorn-standard

    echo "[backend-conda.def] Stage 4b — Astronomy analysis"
    $INSTALL_CMD -n visivo -c conda-forge \
        photutils \
        reproject \
        scikit-image

    echo "[backend-conda.def] Stage 4b-bis — Source finding (SoFiA-2)"
    # conda-forge builds sofia-2 for linux-64 ONLY — there is no ppc64le and
    # no aarch64 package (checked on anaconda.org). So an unconditional
    # `conda install sofia-2` fails the build on Power9, which is one of the
    # architectures these images target.
    #
    # Try the package; otherwise build the pinned release from source. SoFiA-2
    # lives on GitLab (the GitHub repository is archived and holds only a
    # README) and needs WCSLIB, which conda-forge does not build for ppc64le
    # either: the base image's Ubuntu provides it (wcslib-dev) with gcc, and
    # the binary links against the system library. If neither works, do NOT
    # fail the image: the backend already answers "SoFiA-2 is not installed on
    # the server" for that one tool and everything else keeps working.
    SOFIA_REF="${SOFIA_REF:-v2.7.1}"
    if $INSTALL_CMD -n visivo -c conda-forge sofia-2; then
        echo "[backend-conda.def] SoFiA-2 installed from conda-forge"
    else
        echo "[backend-conda.def] no conda-forge sofia-2 for this architecture — building ${SOFIA_REF} from source"
        if apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
               build-essential wcslib-dev git ca-certificates \
           && git clone --depth 1 --branch "${SOFIA_REF}" https://gitlab.com/SoFiA-Admin/SoFiA-2.git /tmp/SoFiA-2 \
           && make -C /tmp/SoFiA-2 OMP=true CC=/usr/bin/gcc \
           && install -m 755 /tmp/SoFiA-2/sofia /opt/conda/envs/visivo/bin/sofia \
           && linkage=$(ldd /opt/conda/envs/visivo/bin/sofia 2>&1) \
           && ! printf '%s\n' "$linkage" | grep -q "not found"; then
            echo "[backend-conda.def] SoFiA-2 ${SOFIA_REF} built from source"
        else
            # Nothing half-installed: a binary that cannot load would be
            # advertised as an available finder.
            rm -f /opt/conda/envs/visivo/bin/sofia
            echo "[backend-conda.def] WARN: SoFiA-2 unavailable — source finding will be disabled"
        fi
        rm -rf /tmp/SoFiA-2 /var/lib/apt/lists/*
    fi
    # resolve_sofia_bin() accepts either name; provide both.
    if [ -x /opt/conda/envs/visivo/bin/sofia ] && [ ! -e /opt/conda/envs/visivo/bin/sofia2 ]; then
        ln -s /opt/conda/envs/visivo/bin/sofia /opt/conda/envs/visivo/bin/sofia2
    fi

    echo "[backend-conda.def] Stage 4c — Astroquery (heavy dep tree)"
    $INSTALL_CMD -n visivo -c conda-forge \
        astroquery

    echo "[backend-conda.def] Stage 4d — Distributed compute"
    $INSTALL_CMD -n visivo -c conda-forge \
        dask \
        distributed

    # ── Optional: cupy (NVIDIA GPU) ────────────────────────────────────────
    # Set APPTAINERENV_ENABLE_CUPY=1 in the build environment (Apptainer
    # passes only APPTAINERENV_-prefixed variables into %post, as ENABLE_CUPY).
    # On ppc64le conda-forge has cupy up to 13.1. Unlike the slim variant
    # which had to fight with apt-mirrored wheels, conda-forge's cupy
    # package bundles its own CUDA runtime — no host CUDA toolkit needed.
    # Apptainer --nv at runtime exposes the NVIDIA driver into the
    # container so cupy can talk to the GPU.
    if [ "${ENABLE_CUPY:-0}" = "1" ]; then
        echo "[backend-conda.def] ENABLE_CUPY=1 → installing cupy from conda-forge"
        $INSTALL_CMD -n visivo -c conda-forge cupy
    else
        echo "[backend-conda.def] ENABLE_CUPY not set → skipping GPU acceleration"
    fi

    # ── Cleanup caches to shrink the final image ──────────────────────────
    conda clean --all --yes

    # ── Copy application source ────────────────────────────────────────────
    mkdir -p /app
    cp -r "$SRC_DIR"/* /app/

    # ── Sanity check ───────────────────────────────────────────────────────
    python -c "
import fastapi, astropy, numpy, scipy, healpy, numba, vtk
print(f'[sanity] fastapi {fastapi.__version__}')
print(f'[sanity] astropy {astropy.__version__}')
print(f'[sanity] numpy   {numpy.__version__}')
print(f'[sanity] scipy   {scipy.__version__}')
print(f'[sanity] healpy  {healpy.__version__}')
print(f'[sanity] numba   {numba.__version__}')
print(f'[sanity] vtk     {vtk.vtkVersion.GetVTKVersion()}')
print('[sanity] Full conda stack OK')
"

%setup
    # Same %setup as backend.def — stage ${PWD}/backend → /srv/backend_src
    # inside the in-progress rootfs, so %post can find requirements.txt
    # and the application source.
    set -ex
    ROOTFS="${APPTAINER_ROOTFS:-${SINGULARITY_ROOTFS:-}}"
    if [ -z "$ROOTFS" ]; then
        echo "ERROR: Neither APPTAINER_ROOTFS nor SINGULARITY_ROOTFS is set."
        exit 1
    fi
    SRC="${VISIVO_BACKEND_SRC:-}"
    if [ -z "$SRC" ] || [ ! -d "$SRC" ]; then
        if [ -d "${PWD}/backend" ]; then
            SRC="${PWD}/backend"
        elif [ -d "${PWD}/../backend" ]; then
            SRC="${PWD}/../backend"
        else
            echo "ERROR: backend/ source directory not found."
            echo "Tried: \$VISIVO_BACKEND_SRC, \${PWD}/backend, \${PWD}/../backend"
            exit 1
        fi
    fi
    echo "[%setup] Staging backend source from: $SRC → $ROOTFS/srv/backend_src"
    mkdir -p "$ROOTFS/srv/backend_src"
    # Stage the application, not the developer's world. A plain `cp -r` of
    # backend/ carries whatever the host happens to have in there — and the
    # documented way to build this image is from a working tree, where
    # backend/.venv is a virtualenv of 1.4 GB that was built for the host's
    # OS and cannot run in this container anyway. Measured on one checkout:
    # 2.5 MB of payload inside 1.4 GB of copy, and copied again when /app is
    # populated from here.
    #
    # tar rather than cp: --exclude is honoured by both GNU tar and the
    # bsdtar macOS ships, and %setup runs on the host, so it may be either.
    tar -cf - -C "$SRC" \
        --exclude='./.venv' \
        --exclude='./.git' \
        --exclude='*__pycache__*' \
        --exclude='*.pyc' \
        --exclude='*.pytest_cache*' \
        . | tar -xf - -C "$ROOTFS/srv/backend_src/"
    if [ ! -f "$ROOTFS/srv/backend_src/requirements.txt" ]; then
        echo "ERROR: requirements.txt NOT present after copy from $SRC"
        exit 1
    fi
    echo "[%setup] OK — backend/ staged into rootfs, %post can proceed."

%runscript
    #!/bin/bash
    HOST="${VISIVO_HOST:-0.0.0.0}"
    PORT="${PORT:-8000}"
    WORKERS="${VISIVO_WORKERS:-$(nproc)}"

    echo "[VisIVO/conda] Starting backend on ${HOST}:${PORT} with ${WORKERS} worker(s)"

    exec uvicorn app.main:app \
        --host "${HOST}" \
        --port "${PORT}" \
        --workers 1 \
        --log-level info \
        --app-dir /app

%test
    # The backend creates its workspace and caches at import, under $HOME by
    # default, which can be read-only where the image is built (an HPC
    # frontend): the test points them at /tmp.
    export VISIVO_EXPORTS_DIR=/tmp/visivo-test/exports VISIVO_HIPS_CACHE=/tmp/visivo-test/hips
    python -c "
import sys, platform
sys.path.insert(0, '/app')
from app.auth import TOKEN
from app.sessions import REGISTRY
print(f'[test] Architecture: {platform.machine()}')
print(f'[test] Python: {sys.version.split()[0]}')
print(f'[test] Auth module OK. Token length: {len(TOKEN)}')
print(f'[test] Sessions module OK.')
import numpy, scipy, astropy, healpy, numba, vtk
print(f'[test] numpy {numpy.__version__}, scipy {scipy.__version__}, '
      f'astropy {astropy.__version__}, healpy {healpy.__version__}')
print(f'[test] numba {numba.__version__} (JIT available), '
      f'vtk {vtk.vtkVersion.GetVTKVersion()} (isosurface available)')
print('[test] Full conda-forge stack verified.')
import shutil
sofia = shutil.which('sofia2') or shutil.which('sofia') or 'not installed (source finding disabled)'
print('[test] SoFiA-2: ' + sofia)
try:
    import cupy
    print(f'[test] cupy {cupy.__version__} (GPU kernels available with --nv)')
except ImportError:
    print('[test] cupy not installed (CPU only)')
"
