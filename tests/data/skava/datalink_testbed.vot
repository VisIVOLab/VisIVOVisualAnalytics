  <RESOURCE type="meta" ID="soda-sync-big" utype="adhoc:service">
    <DESCRIPTION>SODA cutout on node BIG, next to the data.</DESCRIPTION>
    <PARAM name="standardID" datatype="char" arraysize="*" value="ivo://ivoa.net/std/SODA#sync-1.0"/>
    <PARAM name="accessURL" datatype="char" arraysize="*" value="http://node-big:8000/soda/sync"/>
    <GROUP name="inputParams">
      <PARAM name="ID" datatype="char" arraysize="*" value="file:///data/cubes/tb-cube-l.fits"/>
      <PARAM name="POS" datatype="char" arraysize="*" ucd="phys.angArea;obs" value=""/>
      <PARAM name="CIRCLE" datatype="double" arraysize="3" xtype="circle" unit="deg" ucd="phys.angArea;obs" value=""/>
      <PARAM name="POLYGON" datatype="double" arraysize="*" xtype="polygon" unit="deg" ucd="phys.angArea;obs" value=""/>
      <PARAM name="BAND" datatype="double" arraysize="2" xtype="interval" unit="m" ucd="em.wl;stat.interval" value=""/>
      <PARAM name="TIME" datatype="double" arraysize="2" xtype="interval" unit="d" ucd="time.interval;obs.exposure" value=""/>
    </GROUP>
  </RESOURCE>
