# VisIVO VR pairing service: a hardened systemd unit (issue #345).
#
# For this layout (change the paths if yours differ):
#   /home/visivo-vr/visivo-vr-pair/                 the service, owned by visivo-vr
#   /home/visivo-vr/visivo-vr-pair/venv/            its virtual environment (python3.13)
#   /home/visivo-vr/visivo-vr-pair/pair_secret      VR_PAIR_SECRET, mode 0600
# Apache proxies /pair/ to 127.0.0.1:8765 (deploy/apache-pair.conf).
#
# Install:  cp visivo-vr-pair.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl restart visivo-vr-pair
# Check:    systemd-analyze security visivo-vr-pair.service
#
# The hardening holds even if the service had a bug a client could use: the
# process sees no other user's files, no devices, no other processes, no
# kernel knobs, cannot gain privileges, write anywhere on disk, run code it
# writes into memory, open a socket to any address but this machine's, bind
# any port but its own, or take more than its share of memory, tasks, files
# and CPU. Every line says what it does.

[Unit]
Description=VisIVO VR pairing service (visivo-pair/1)
Documentation=https://github.com/VisIVOLab/VisIVOVisualAnalytics/blob/main/services/vr-pair/README.md
After=network.target
# Never give up restarting: a client that could crash it ten times must not
# leave it down until somebody notices (the delay grows instead, below).
StartLimitIntervalSec=0

[Service]
Type=exec
User=visivo-vr
Group=visivo-vr
WorkingDirectory=/home/visivo-vr/visivo-vr-pair
ExecStart=/home/visivo-vr/visivo-vr-pair/venv/bin/python vr_pair_service.py
Restart=always
# 2 s after the first exit, growing over 5 restarts to 60 s (systemd 254 or
# later; older versions ignore these two lines and wait 2 s each time).
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s

# ── Settings (README.md, Configuration) ──────────────────────────────────────
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
Environment=VR_PAIR_BIND=127.0.0.1 VR_PAIR_PORT=8765
Environment=VR_PAIR_ALLOWED_ORIGINS=https://vr.visivolab.oact.inaf.it
Environment=VR_PAIR_TRUST_PROXY=1
# The secret in a file (owner visivo-vr, mode 0600), never in an
# Environment= line: "systemctl show" prints those to any local user.
Environment=VR_PAIR_SECRET_FILE=/home/visivo-vr/visivo-vr-pair/pair_secret
# Shared NAT (an institute behind one address): see README.md, Security,
# for values above the defaults, e.g.
#Environment=VR_PAIR_HOSTS_PER_IP=64 VR_PAIR_CODES_PER_IP_PER_MIN=300 VR_PAIR_LIVE_CODES_PER_IP=512
#Environment=VR_PAIR_JOIN_FAILS_PER_IP=60 VR_PAIR_JOIN_CONNS_PER_IP=64 VR_PAIR_CONNS_PER_IP_PER_MIN=600

# ── Privileges ───────────────────────────────────────────────────────────────
# No capabilities at all, now or after an exec.
CapabilityBoundingSet=
AmbientCapabilities=
# setuid binaries, file capabilities and the like cannot raise privileges.
NoNewPrivileges=yes
# Files it creates are readable by itself only.
UMask=0077
# Its own user namespace: other users and groups show as "nobody".
PrivateUsers=yes
# No setuid or setgid files can be made.
RestrictSUIDSGID=yes
# System V IPC objects of the user are removed when it stops.
RemoveIPC=yes
# Its own kernel keyring.
KeyringMode=private

# ── File system ──────────────────────────────────────────────────────────────
# /usr, /boot, /efi and /etc read-only: nothing on disk is writable.
ProtectSystem=strict
# /home, /root and /run/user empty; only the service directory is visible,
# read-only (the code, the virtual environment, the secret).
ProtectHome=tmpfs
BindReadOnlyPaths=/home/visivo-vr/visivo-vr-pair
# Its own /tmp and /var/tmp, removed when it stops.
PrivateTmp=yes
# The other sites' files and certificates are not even visible ("-": skip
# the ones this server does not have).
InaccessiblePaths=-/var/www -/srv -/etc/apache2 -/etc/letsencrypt -/etc/ssl/private
# Its own /dev with null, zero, random and the like only.
PrivateDevices=yes
# /proc shows its own processes only, and none of the kernel's other files.
ProtectProc=invisible
ProcSubset=pid

# ── Kernel ───────────────────────────────────────────────────────────────────
# /proc/sys, /sys and the like read-only.
ProtectKernelTunables=yes
# No kernel module loading.
ProtectKernelModules=yes
# No access to the kernel log.
ProtectKernelLogs=yes
# The control groups read-only.
ProtectControlGroups=yes
# The clock cannot be set.
ProtectClock=yes
# The host name cannot be changed.
ProtectHostname=yes
# No new namespaces (no containers within).
RestrictNamespaces=yes
# No real-time scheduling (which could starve the other sites).
RestrictRealtime=yes
# The execution domain cannot be changed.
LockPersonality=yes
# No memory both writable and executable: no code written at run time.
# CPython (without its experimental JIT) and websockets do not need it.
MemoryDenyWriteExecute=yes

# ── System calls ─────────────────────────────────────────────────────────────
# Native system calls only (no 32-bit ABI to slip filters through).
SystemCallArchitectures=native
# The calls an ordinary service makes, minus privileged and resource ones.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A denied call fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM

# ── Network ──────────────────────────────────────────────────────────────────
# IPv4, IPv6 and Unix sockets (the journal) only: no raw or netlink sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Traffic to and from this machine only: the service never connects out,
# and Apache reaches it on 127.0.0.1.
IPAddressDeny=any
IPAddressAllow=localhost
# It can bind its own port only.
SocketBindAllow=tcp:8765
SocketBindDeny=any

# ── Resources (bounds that keep the other sites served) ──────────────────────
# Memory: throttled above 192 MiB, killed and restarted above 384 MiB, no
# swap. Measured: ~35 MiB idle, ~48 MiB with its 512 hosts and 128 pages
# open; a hostile client can make one connection hold at most ~0.5 MiB, so
# even 640 such stay under the cap.
MemoryHigh=192M
MemoryMax=384M
MemorySwapMax=0
# Processes and threads: asyncio uses one, plus a few for name lookups.
TasksMax=32
# Open files: 640 WebSockets (VR_PAIR_MAX_HOSTS + VR_PAIR_MAX_PAGES),
# connections still in their handshake, and slack.
LimitNOFILE=4096
# At most half of one CPU.
CPUQuota=50%
# At most 1000 log lines every 30 s reach the journal.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
